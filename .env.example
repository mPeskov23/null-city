# Copy to .env. Never commit credentials or private TLS keys.
BIND=0.0.0.0
PORT=8443
PUBLIC_ORIGIN=https://localhost:8443

# Multiplayer over Local Network (LAN):
# Specify your host machine's LAN IP address (e.g. 192.168.1.50)
# to include it in the TLS certificate SAN and allowed origins:
# HOST_IP=192.168.1.50
# ALLOWED_ORIGINS=https://localhost:8443,https://192.168.1.50:8443

# Native Python mode only:
# DATABASE_PATH=data/nullcity.sqlite3
# TLS_CERT=data/tls/cert.pem
# TLS_KEY=data/tls/key.pem

# Verified automatic backups: every 6 hours; keep 7 snapshots.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETAIN=7

# ---- Email 2FA (SMTP container "smtp" = Mailpit, see docs/SMTP-2FA.md) ----
# Defaults work as-is: mail is captured, visible at https://localhost:<MAIL_UI_PORT>.
# SMTP port 1025 is internal to the compose network (never published).
# Host port of the Mailpit web inbox (bound to 127.0.0.1 only).
MAIL_UI_PORT=8025
# App-side client settings (already the defaults in compose.yaml):
# SMTP_HOST=smtp
# SMTP_PORT=1025
# SMTP_TLS=starttls            # starttls | ssl | none
# SMTP_CA=/run/smtp/ca.pem     # public CA generated by the smtp-init job
# SMTP_FROM=Null City <no-reply@nullcity.local>
# Login to the internal SMTP: leave EMPTY to use the random one generated at first start.
# SMTP_USER=
# SMTP_PASSWORD=

# Optional REAL delivery through an external provider (leave empty = capture only).
# Gmail example (needs 2-step verification + an "app password", never the account password):
# MP_SMTP_RELAY_HOST=smtp.gmail.com
# MP_SMTP_RELAY_PORT=587
# MP_SMTP_RELAY_STARTTLS=true
# MP_SMTP_RELAY_AUTH=plain
# MP_SMTP_RELAY_USERNAME=your.address@gmail.com
# MP_SMTP_RELAY_PASSWORD=xxxxxxxxxxxxxxxx
# MP_SMTP_RELAY_OVERRIDE_FROM=your.address@gmail.com
# MP_SMTP_RELAY_ALL=true       # auto-relay every message (otherwise: "Release" button in the UI)
