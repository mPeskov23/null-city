# Copy to .env. Never commit credentials or private TLS keys.
BIND=0.0.0.0
PORT=8443
PUBLIC_ORIGIN=https://localhost:8443

# Multiplayer over Local Network (LAN):
# Specify your host machine's LAN IP address (e.g. 192.168.1.50)
# to include it in the TLS certificate SAN and allowed origins:
# HOST_IP=192.168.1.50
# ALLOWED_ORIGINS=https://localhost:8443,https://192.168.1.50:8443

# Native Python mode only:
# DATABASE_PATH=data/nullcity.sqlite3
# TLS_CERT=data/tls/cert.pem
# TLS_KEY=data/tls/key.pem

# Verified automatic backups: every 6 hours; keep 7 snapshots.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETAIN=7
