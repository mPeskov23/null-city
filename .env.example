# NULL//CITY — Конфигурация окружения
# ВНИМАНИЕ: PUBLIC_ORIGIN должен в точности совпадать с тем адресом и портом,
# который вы открываете в браузере (включая https://), иначе все API-запросы
# будут отклоняться сервером с ошибкой 403 Forbidden!

# Публичный адрес приложения, проверяемый сервером (Origin header)
PUBLIC_ORIGIN=https://localhost:8443

# Порт HTTPS-сервера
PORT=8443

# Хост привязки (127.0.0.1 для локального запуска, 0.0.0.0 для Docker)
BIND=127.0.0.1

# Путь к базе данных SQLite
DATABASE_PATH=data/nullcity.sqlite3

# Пути к TLS-сертификатам (если не существуют, создаются автоматически)
TLS_CERT=data/tls/cert.pem
TLS_KEY=data/tls/key.pem
